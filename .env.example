# Copy to .env and fill in. .env is read at import time by server/config.py.
# Never commit the real file.

ANTHROPIC_API_KEY=sk-ant-...

# --- identity -------------------------------------------------------------
JARVIS_PRINCIPAL=Jonathan
JARVIS_ADDRESS_AS=Sir

# --- backend --------------------------------------------------------------
# anthropic  Opus 5. Streams real reasoning, has web search and tools.
# ollama     Local open-weights model. Offline, fewer provider-side
#            restrictions, no tools, lower capability.
JARVIS_BACKEND=anthropic
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=high
JARVIS_MAX_TOKENS=64000

JARVIS_OLLAMA_MODEL=qwen3:32b
OLLAMA_HOST=http://127.0.0.1:11434

# --- behaviour ------------------------------------------------------------
JARVIS_MAX_ITERATIONS=40
JARVIS_RESEARCH_PASSES=6

# 1 skips the approval card for shell commands and file writes. Off by default.
JARVIS_AUTONOMOUS=0

# Semicolon-separated roots that file and shell tools are confined to.
JARVIS_WORKSPACE_ROOTS=D:\;C:\Users\plata\dev;C:\Users\plata\Documents;C:\Users\plata\Desktop

# --- server ---------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8777
