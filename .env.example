# Copy to .env and fill in. .env is read at import time by server/config.py.
# Never commit the real file.

ANTHROPIC_API_KEY=sk-ant-...

# --- identity -------------------------------------------------------------
JARVIS_PRINCIPAL=Jonathan
JARVIS_ADDRESS_AS=Sir

# --- backend --------------------------------------------------------------
# Boot default only. Switch live by voice: "switch to your local brain",
# "switch to gemma 4 12b", "switch to uncensored mode", "go back to your
# cloud brain". The choice persists in data/switchboard.json.
# anthropic  Claude. Streams real reasoning, has web search and tools.
# ollama     Local open-weights model with the same local tools (needs a
#            tool-capable model), no server-side web search.
JARVIS_BACKEND=anthropic
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=high
JARVIS_MAX_TOKENS=64000

JARVIS_OLLAMA_MODEL=qwen3:32b
OLLAMA_HOST=http://127.0.0.1:11434

# Local model used by "switch to uncensored mode", e.g. an abliterated GGUF
# you loaded into Ollama. Leave empty to disable. Approval gates still apply.
JARVIS_UNCENSORED_MODEL=

# --- voice ----------------------------------------------------------------
# edge | elevenlabs | local. Switch live: "switch to your ElevenLabs voice".
JARVIS_VOICE=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Optional local voice-clone server: POST {"text": ...} -> audio bytes.
JARVIS_LOCAL_TTS_URL=

# --- behaviour ------------------------------------------------------------
JARVIS_MAX_ITERATIONS=40
JARVIS_RESEARCH_PASSES=6

# 1 skips the approval card for shell commands and file writes. Off by default.
JARVIS_AUTONOMOUS=0

# Semicolon-separated roots that file and shell tools are confined to.
JARVIS_WORKSPACE_ROOTS=D:\;C:\Users\plata\dev;C:\Users\plata\Documents;C:\Users\plata\Desktop

# --- server ---------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8777
